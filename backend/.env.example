# ---------------------------------------------------------------------------
# 激浪 环境变量示例（仅占位符，不要填入真实密钥后提交到版本库）
# 复制为 .env 后按需修改。
# ---------------------------------------------------------------------------

# 让 crosspilot.* 能被 python -m crosspilot 直接找到（从项目根目录运行时生效）
PYTHONPATH=.

# ---- 服务 -----------------------------------------------------------------
CROSSPILOT_HOST=127.0.0.1
CROSSPILOT_PORT=8000
CROSSPILOT_RELOAD=false

# 数据目录（相对路径以项目根目录为基准）
CROSSPILOT_DATA_DIR=data

# ---- 数据库 ---------------------------------------------------------------
# 本地：postgresql://postgres:postgres@127.0.0.1:5432/crosspilot
# 线上：Supabase pooler（端口 6543）
CROSSPILOT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crosspilot
# 迁移专用直连（Supabase 5432）；为空则用上面的 DATABASE_URL
CROSSPILOT_MIGRATION_DATABASE_URL=
# 启动时自动迁移；生产建议 false，改用 `python -m crosspilot migrate`
CROSSPILOT_AUTO_MIGRATE=true

# ---- 加密主密钥 -----------------------------------------------------------
# API Key 加密用。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# 本地：留空会自动生成 data/.secret_key 文件。
# **Serverless（Vercel）必须显式设置**：函数文件系统只读，无法持久化密钥文件，
# 代码会走 _generate_persisted() 并失败，保存 API Key 的接口直接返回 500。
#
# 一旦设定就不要改：改了已保存的 Key 全部无法解密。
CROSSPILOT_SECRET_KEY=

# ---- 生成 Provider（进程级默认值） ----------------------------------------
# BYOK：用户真正的 Key 在「设置 → 模型与密钥」里按账号配置。
# 这里的 provider 只是"没有用户配置时"的兜底。
#   rule     : 本地规则引擎（离线、可测；Listing 为事实直出草案，需人工改写）
#   deepseek : DeepSeek 官方 API（OpenAI 兼容）
#   openai   : 任意 OpenAI 兼容服务（兼容旧配置）
CROSSPILOT_PROVIDER=rule

# 没有可用 Key 时，需要模型的接口是否直接 428（BYOK 强制）。
# true  = 演示站行为：明确要求配置 Key，不静默降级
# false = 退回旧行为：降级为规则引擎并在结果里明确标注（仅本地/测试建议）
CROSSPILOT_REQUIRE_API_KEY=true

# ---- DeepSeek 官方 API（可选，作为进程级默认） ----------------------------
# 申请地址：https://platform.deepseek.com/api_keys
CROSSPILOT_DEEPSEEK_API_KEY=
CROSSPILOT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以官方文档为准：deepseek-flash（推荐）/ deepseek-v4-pro（增强版）
CROSSPILOT_DEEPSEEK_MODEL=deepseek-flash
CROSSPILOT_DEEPSEEK_TIMEOUT=90
CROSSPILOT_DEEPSEEK_MAX_RETRIES=2
CROSSPILOT_DEEPSEEK_TEMPERATURE=0.5
CROSSPILOT_DEEPSEEK_THINKING=false
CROSSPILOT_DEEPSEEK_REASONING_EFFORT=

# ---- 演示站机制 -----------------------------------------------------------
# 固定 demo 账号：共享、只读示例数据、禁止保存 Key。
# 密码留空则不创建该账号（推荐线上一定要设一个强口令）。
CROSSPILOT_DEMO_USERNAME=demo
CROSSPILOT_DEMO_PASSWORD=
# 一键体验临时账号有效期（小时）
CROSSPILOT_GUEST_TTL_HOURS=24
# 限流（按账号）
CROSSPILOT_RATE_LIMIT_ENABLED=true
CROSSPILOT_RATE_LIMIT_TASKS_PER_HOUR=10
CROSSPILOT_RATE_LIMIT_KEY_TESTS_PER_HOUR=5
# 一键体验按 IP 限流：公网演示站最容易被刷的入口（无需凭据）
CROSSPILOT_RATE_LIMIT_GUEST_PER_HOUR=5

# ---- 数据源 ---------------------------------------------------------------
# mock：全部来自模拟数据源（每条记录带 is_mock=true）
# 真实接入时按连接逐个切换（store_connections.mode = "live"），不是全局开关
CROSSPILOT_MARKETPLACE_MODE=mock

# ---- 上传限制 -------------------------------------------------------------
CROSSPILOT_MAX_UPLOAD_BYTES=5242880

# ---- 注册策略 -------------------------------------------------------------
# false：除首个用户外，注册必须携带租户邀请令牌（管理员在「设置 → 团队」生成）
CROSSPILOT_ALLOW_OPEN_REGISTRATION=true

# ---- 长任务执行器 ---------------------------------------------------------
# thread：进程内线程（默认，无需外部服务）
# arq   ：独立 worker + Redis（需 arq + redis，并启动 crosspilot.worker）
CROSSPILOT_TASK_QUEUE=thread
CROSSPILOT_REDIS_URL=redis://127.0.0.1:6379/0
# 强制同步执行：部署到 Serverless（Vercel 等）时必须为 true。
# 这类平台的实例在响应结束后会被冻结，进程内线程队列的后台任务会就地停摆，
# 任务永远停在 running。打开后忽略 async_run，在本次请求内跑完再返回
#（前端表现为"转圈等结果"，而不是"立即返回 + 后台轮询"）。
CROSSPILOT_FORCE_SYNC_TASKS=false

# ---- 存储后端 -------------------------------------------------------------
# local    ：落本地磁盘（data/uploads），仅适合本地开发
# supabase ：Supabase Storage（Render 免费实例磁盘是临时的，线上必须用它）
CROSSPILOT_STORAGE_BACKEND=local
CROSSPILOT_SUPABASE_URL=
CROSSPILOT_SUPABASE_SERVICE_KEY=
CROSSPILOT_SUPABASE_BUCKET=crosspilot

# ---- 部署相关 -------------------------------------------------------------
# HTTPS 部署必须设 true（Cookie 带 Secure）
CROSSPILOT_COOKIE_SECURE=false
# CORS 允许来源（逗号分隔）；空表示仅同源
CROSSPILOT_ALLOWED_ORIGINS=
