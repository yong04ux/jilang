{
  "name": "crosspilot-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CrossPilot 前端（React + TypeScript）。构建产物 dist/ 由 FastAPI 直接托管，目录形状必须与后端挂载点一致。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:css && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:css && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "preview": "vite preview --port 5174 --strictPort",
    "parity": "node scripts/api-parity.mjs && node scripts/primitives-parity.mjs && node scripts/render-parity.mjs && node scripts/poller-check.mjs",
    "parity:charts": "node scripts/charts-parity.mjs",
    "parity:api": "node scripts/api-parity.mjs",
    "parity:primitives": "node scripts/primitives-parity.mjs",
    "parity:render": "node scripts/render-parity.mjs",
    "check:poller": "node scripts/poller-check.mjs",
    "probe": "node scripts/probe-all.mjs",
    "smoke": "node scripts/ui_pages_smoke.mjs",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/styles/tailwind.css -o css/tailwind.css --watch",
    "ab:tailwind": "node scripts/tailwind-ab.mjs",
    "diff:png": "node scripts/png-diff.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
