# ---------------------------------------------------------------------------
# CrossPilot · 本地数据与构建产物（不要提交）
# ---------------------------------------------------------------------------

# 结构重组期间的快照备份（恢复用，不是交付物）
_backup/

# 数据库与运行期数据（含客户私有数据，绝不入库）
data/crosspilot.db
data/*.db
data/*.db-*
data/uploads/
data/acl-recovery/
uploads/
workspace/

# 加密密钥：模型 API Key 的本地解密材料，泄漏等于泄漏密钥
data/.secret_key
*.secret_key

# 凭据：.env 与任何本地变体都不得提交（.env.example 是唯一例外，见文件末尾）
.env
.env.*
!.env.example
*.env
!.env.example

# ---------------------------------------------------------------------------
# 测试产物
# ---------------------------------------------------------------------------
.pytest_cache/
.pytest-tmp/
.pytest-basetemp/
pytest-of-*/
tmp*/
tmp-*/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node（仅 frontend/scripts 下的诊断脚本可能需要）
# ---------------------------------------------------------------------------
node_modules/
*.tsbuildinfo

# 本地截图/巡检脚本：会硬编码演示账号口令与本地地址，只在本机跑，不入库
frontend/scripts/ui_shots_*.mjs

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 本次不纳入版本库
# ---------------------------------------------------------------------------
# 前端代码**已纳入版本库**（2026-10-21）：Vercel 构建与后端 StaticFiles 都直接从
# 仓库取 frontend/，再不提交会导致部署后前端 404。构建产物 dist/ 与 node_modules/
# 仍由上面的规则排除。

# 项目计划与设计文档：内部规划材料，暂不上传
/docs/

# WorkBuddy 会话与记忆数据
/.workbuddy/

# 运行日志
*.log

# 数据库备份转储（含数据，不入库）
**/data/backups/
