  "cards": [
    {
      "dot": "cyan",
      "title": "一次任务怎么跑",
      "items": [
        "页面提交后立即返回，由进程内线程队列后台执行",
        "前端每秒轮询任务详情，到终态才停止",
        "组合工作流停在确认点时，由确认接口恢复"
      ]
    },
    {
      "dot": "violet",
      "title": "代码库分层",
      "items": [
        "backend/crosspilot 按 api、agent、engine、llm、persistence 分域",
        "frontend/src 按 features、lib、components 分域",
        "两端同属一个仓库，前端构建产物 dist/ 也入库"
      ]
    },
    {
      "dot": "emerald",
      "title": "自带密钥",
      "items": [
        "可配置自己账号的厂商、地址与模型",
        "没有密钥时规则引擎照常跑完，接口如实标注执行引擎",
        "密钥加密落库，模型调用只记录用量与耗时"
      ]
    },
    {
      "dot": "amber",
      "title": "线上形态",
      "items": [
        "Render 单进程同时托管页面、接口与后台线程",
        "Gitee 的 main 分支触发自动部署，服务端只装 Python 依赖",
        "数据库与私有对象存储由 Supabase 提供"
      ]
    }
  ]
